# 이 파일을 .env로 복사해서 값을 채우세요.
#
#   cp .env.example .env
#
# .env는 .gitignore에 있어 커밋되지 않습니다. 실제 키를 이 파일에 적지 마세요.
# 코드에서 이 값을 읽는 곳은 core/config.py 한 곳입니다.


# ---------------------------------------------------------------------------
# 필수
# ---------------------------------------------------------------------------

# PostgreSQL 접속 문자열 (libpq 키워드 형식)
# pgvector 확장이 설치된 DB여야 합니다.
DATABASE_URL=dbname=riido user=postgres password=postgres host=localhost port=5432

# OpenAI API 키
# 임베딩(text-embedding-3-small), 질문 정제·제목 생성(gpt-4o-mini),
# 답변 생성·평가(gpt-4o)에 모두 씁니다. 없으면 서버가 부팅되지 않습니다.
OPENAI_API_KEY=sk-...


# ---------------------------------------------------------------------------
# 선택 — 없으면 괄호 안 기본값을 씁니다
# ---------------------------------------------------------------------------

# DB 커넥션 풀 크기 (1 / 10)
# API 서버와, core.search를 직접 쓰는 스크립트에 함께 적용됩니다.
# 동시 요청이 많아 "connection pool exhausted"가 보이면 최대치를 올리세요.
#DB_POOL_MIN=1
#DB_POOL_MAX=10

# 골든셋 라벨링에 쓸 모델 (gpt-4o)
# scripts/build_golden_set.py에서만 읽습니다. 평가 품질 실험용이라
# 평소에는 건드릴 일이 없습니다.
#GOLDEN_LABEL_MODEL=gpt-4o
